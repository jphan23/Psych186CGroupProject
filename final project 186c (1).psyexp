        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="var _pj;&amp;#10;function _pj_snippets(container) {&amp;#10;    function in_es6(left, right) {&amp;#10;        if (((right instanceof Array) || ((typeof right) === &quot;string&quot;))) {&amp;#10;            return (right.indexOf(left) &gt; (- 1));&amp;#10;        } else {&amp;#10;            if (((right instanceof Map) || (right instanceof Set) || (right instanceof WeakMap) || (right instanceof WeakSet))) {&amp;#10;                return right.has(left);&amp;#10;            } else {&amp;#10;                return (left in right);&amp;#10;            }&amp;#10;        }&amp;#10;    }&amp;#10;    container[&quot;in_es6&quot;] = in_es6;&amp;#10;    return container;&amp;#10;}&amp;#10;_pj = {};&amp;#10;_pj_snippets(_pj);&amp;#10;pressed_key = response_key.keys;&amp;#10;timed_out = _pj.in_es6(pressed_key, [null, &quot;&quot;, []]);&amp;#10;if (timed_out) {&amp;#10;    response_answer = &quot;no_response&quot;;&amp;#10;    said_two = null;&amp;#10;    correct = null;&amp;#10;    rt = null;&amp;#10;    sdt_label = null;&amp;#10;} else {&amp;#10;    if ((pressed_key === yes_key)) {&amp;#10;        response_answer = &quot;yes&quot;;&amp;#10;        said_two = 1;&amp;#10;    } else {&amp;#10;        response_answer = &quot;no&quot;;&amp;#10;        said_two = 0;&amp;#10;    }&amp;#10;    rt = response_key.rt;&amp;#10;    if ((rt instanceof Array)) {&amp;#10;        rt = rt[0];&amp;#10;    }&amp;#10;    actual_two = Number.parseInt((n_flashes === 2));&amp;#10;    correct = Number.parseInt((said_two === actual_two));&amp;#10;    if (((actual_two === 1) &amp;&amp; (said_two === 1))) {&amp;#10;        sdt_label = &quot;hit&quot;;&amp;#10;    } else {&amp;#10;        if (((actual_two === 1) &amp;&amp; (said_two === 0))) {&amp;#10;            sdt_label = &quot;miss&quot;;&amp;#10;        } else {&amp;#10;            if (((actual_two === 0) &amp;&amp; (said_two === 1))) {&amp;#10;                sdt_label = &quot;false_alarm&quot;;&amp;#10;            } else {&amp;#10;                sdt_label = &quot;correct_rejection&quot;;&amp;#10;            }&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# Get the key pressed on this trial.&amp;#10;pressed_key = response_key.keys&amp;#10;&amp;#10;# Check whether the participant missed the deadline.&amp;#10;timed_out = pressed_key in [None, '', []]&amp;#10;&amp;#10;if timed_out:&amp;#10;    response_answer = 'no_response'&amp;#10;    said_two = None&amp;#10;    correct = None&amp;#10;    rt = None&amp;#10;    sdt_label = None&amp;#10;&amp;#10;else:&amp;#10;    # Convert the key into YES or NO using this participant's mapping.&amp;#10;    if pressed_key == yes_key:&amp;#10;        response_answer = 'yes'&amp;#10;        said_two = 1&amp;#10;    else:&amp;#10;        response_answer = 'no'&amp;#10;        said_two = 0&amp;#10;&amp;#10;    # Get response time.&amp;#10;    rt = response_key.rt&amp;#10;&amp;#10;    if isinstance(rt, list):&amp;#10;        rt = rt[0]&amp;#10;&amp;#10;    # A second physical flash means the signal was present.&amp;#10;    actual_two = int(n_flashes == 2)&amp;#10;&amp;#10;    correct = int(said_two == actual_two)&amp;#10;&amp;#10;    # Assign the signal detection label.&amp;#10;    if actual_two == 1 and said_two == 1:&amp;#10;        sdt_label = 'hit'&amp;#10;&amp;#10;    elif actual_two == 1 and said_two == 0:&amp;#10;        sdt_label = 'miss'&amp;#10;&amp;#10;    elif actual_two == 0 and said_two == 1:&amp;#10;        sdt_label = 'false_alarm'&amp;#10;&amp;#10;    else:&amp;#10;        sdt_label = 'correct_rejection'" valType="extendedCode" updates="constant" name="End Routine"/>
