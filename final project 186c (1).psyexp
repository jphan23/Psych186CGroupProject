        <Param val="# Select the trial list for this block.&amp;#10;current_block_trials = all_blocks[blocks.thisN]&amp;#10;&amp;#10;# A human-readable block number: 1, 2, or 3.&amp;#10;block_number = blocks.thisN + 1&amp;#10;&amp;#10;section_text = (&amp;#10;    f&quot;Section {block_number} of 3\n\n&quot;&amp;#10;    &quot;Keep your eyes on the center + throughout the experiment.\n\n&quot;&amp;#10;    &quot;Press SPACE when ready.&quot;)&amp;#10;    " valType="extendedCode" updates="constant" name="Begin Routine"/>
