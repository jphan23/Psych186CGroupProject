        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="if ((familiarity_key.keys === &quot;j&quot;)) {&amp;#10;    prior_familiarity = &quot;yes&quot;;&amp;#10;} else {&amp;#10;    prior_familiarity = &quot;no&quot;;&amp;#10;}&amp;#10;sound_influence_rating = Number.parseInt(awareness_key.keys);&amp;#10;trial_table = new pd.DataFrame(session_list);&amp;#10;output_filepath = `sifi_data/${participant}_${expInfo[&quot;date&quot;]}_trials.csv`;&amp;#10;trial_table.to_csv(output_filepath, {&quot;index&quot;: false});&amp;#10;answered_trials = trial_table.dropna({&quot;subset&quot;: [&quot;said_two&quot;]});&amp;#10;total_trials = trial_table.length;&amp;#10;answered_count = answered_trials.length;&amp;#10;timeout_count = (total_trials - answered_count);&amp;#10;hits = (trial_table[&quot;sdt_label&quot;] === &quot;hit&quot;).sum();&amp;#10;misses = (trial_table[&quot;sdt_label&quot;] === &quot;miss&quot;).sum();&amp;#10;false_alarms = (trial_table[&quot;sdt_label&quot;] === &quot;false_alarm&quot;).sum();&amp;#10;correct_rejections = (trial_table[&quot;sdt_label&quot;] === &quot;correct_rejection&quot;).sum();&amp;#10;summary_table = new pd.DataFrame([{&quot;participant_number&quot;: participant_number, &quot;total_trials&quot;: total_trials, &quot;answered_trials&quot;: answered_count, &quot;timeouts&quot;: timeout_count, &quot;hits&quot;: hits, &quot;misses&quot;: misses, &quot;false_alarms&quot;: false_alarms, &quot;correct_rejections&quot;: correct_rejections, &quot;prior_familiarity&quot;: prior_familiarity, &quot;sound_influence_rating&quot;: sound_influence_rating}]);&amp;#10;summary_filepath = `sifi_data/${participant}_${expInfo[&quot;date&quot;]}_summary.csv`;&amp;#10;summary_table.to_csv(summary_filepath, {&quot;index&quot;: false});&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="if familiarity_key.keys == 'j':&amp;#10;    prior_familiarity = 'yes'&amp;#10;else:&amp;#10;    prior_familiarity = 'no'&amp;#10;&amp;#10;sound_influence_rating = int(awareness_key.keys)&amp;#10;&amp;#10;&amp;#10;# Create and save the raw trial table.&amp;#10;trial_table = pd.DataFrame(session_list)&amp;#10;&amp;#10;output_filepath = (&amp;#10;    f&quot;sifi_data/{participant}_&quot;&amp;#10;    f&quot;{expInfo['date']}_trials.csv&quot;&amp;#10;)&amp;#10;&amp;#10;trial_table.to_csv(output_filepath, index=False)&amp;#10;&amp;#10;&amp;#10;# SUMMARY: use all trials together, without separating sound conditions.&amp;#10;&amp;#10;# Exclude timeouts from response counts.&amp;#10;answered_trials = trial_table.dropna(subset=['said_two'])&amp;#10;&amp;#10;&amp;#10;total_trials = len(trial_table)&amp;#10;answered_count = len(answered_trials)&amp;#10;timeout_count = total_trials - answered_count&amp;#10;&amp;#10;# Count each SDT outcome.&amp;#10;hits = (trial_table['sdt_label'] == 'hit').sum()&amp;#10;misses = (trial_table['sdt_label'] == 'miss').sum()&amp;#10;&amp;#10;false_alarms = (&amp;#10;    trial_table['sdt_label'] == 'false_alarm').sum()&amp;#10;&amp;#10;correct_rejections = (&amp;#10;    trial_table['sdt_label'] == 'correct_rejection').sum()&amp;#10;# &amp;#10;# Create a summary table with exactly one row.&amp;#10;summary_table = pd.DataFrame([{&amp;#10;    'participant_number': participant_number,&amp;#10;    'total_trials': total_trials,&amp;#10;    'answered_trials': answered_count,&amp;#10;    'timeouts': timeout_count,&amp;#10;    'hits': hits,&amp;#10;    'misses': misses,&amp;#10;    'false_alarms': false_alarms,&amp;#10;    'correct_rejections': correct_rejections,&amp;#10;    'prior_familiarity': prior_familiarity,&amp;#10;    'sound_influence_rating': sound_influence_rating&amp;#10;}])&amp;#10;&amp;#10;# Save the participant's count summary.&amp;#10;summary_filepath = (&amp;#10;    f&quot;sifi_data/{participant}_&quot;&amp;#10;    f&quot;{expInfo['date']}_summary.csv&quot;&amp;#10;)&amp;#10;&amp;#10;summary_table.to_csv(summary_filepath, index=False)" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
