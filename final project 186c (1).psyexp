        <Param val="if ((yes_key === &quot;f&quot;)) {&amp;#10;    response_prompt = &quot;Did you see a SECOND flash?\n\nF = YES          J = NO&quot;;&amp;#10;} else {&amp;#10;    response_prompt = &quot;Did you see a SECOND flash?\n\nF = NO          J = YES&quot;;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="&amp;#10;if yes_key == 'f':&amp;#10;    response_prompt = (&amp;#10;        &quot;Did you see a SECOND flash?\n\n&quot;&amp;#10;        &quot;F = YES          J = NO&quot;&amp;#10;    )&amp;#10;&amp;#10;else:&amp;#10;    response_prompt = (&amp;#10;        &quot;Did you see a SECOND flash?\n\n&quot;&amp;#10;        &quot;F = NO          J = YES&quot;&amp;#10;    )" valType="extendedCode" updates="constant" name="Begin Routine"/>
