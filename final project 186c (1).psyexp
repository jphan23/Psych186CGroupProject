      <CodeComponent name="code_2" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="import random&amp;#10;import pandas as pd&amp;#10;&amp;#10;# First name determines the shuffled trial order.&amp;#10;participant = expInfo['participant'].strip().lower()&amp;#10;trial_randomizer = random.Random(participant)&amp;#10;&amp;#10;&amp;#10;# Preassigned group: F = YES, J = NO.&amp;#10;f_yes_names = [&amp;#10;    'leilani', 'sophia', 'rebecca',&amp;#10;    'riley', 'david', 'anna',&amp;#10;    'vy', 'allah', 'patrick',&amp;#10;]&amp;#10;&amp;#10;# Preassigned group: J = YES, F = NO.&amp;#10;j_yes_names = [&amp;#10;    'vidita', 'vicky', 'ava', 'ezekiel',&amp;#10;    'wesley', 'jackson', 'hannah', 'erica'&amp;#10;]&amp;#10;&amp;#10;# Participant number&amp;#10;all_names = f_yes_names + j_yes_names&amp;#10;participant_number = all_names.index(participant) + 1&amp;#10;&amp;#10;# Look up the participant's preassigned mapping.&amp;#10;if participant in f_yes_names:&amp;#10;    yes_key = 'f'&amp;#10;    no_key = 'j'&amp;#10;&amp;#10;elif participant in j_yes_names:&amp;#10;    yes_key = 'j'&amp;#10;    no_key = 'f'&amp;#10;&amp;#10;else:&amp;#10;    raise ValueError(&amp;#10;        'Participant name not found. Check the spelling.'&amp;#10;    )&amp;#10;&amp;#10;# The four sound conditions.&amp;#10;sound_conditions = [&amp;#10;    'no_beep',&amp;#10;    'one_beep',&amp;#10;    'two_sync',&amp;#10;    'two_late'&amp;#10;]&amp;#10;&amp;#10;# This will hold the three blocks.&amp;#10;all_blocks = []&amp;#10;&amp;#10;for block_number in range(3):&amp;#10;&amp;#10;    # Start with an empty trial list for this block.&amp;#10;    block_trials = []&amp;#10;&amp;#10;    for sound_condition in sound_conditions:&amp;#10;&amp;#10;        for n_flashes in [1, 2]:&amp;#10;&amp;#10;            for flash_position in ['upper', 'lower','right','left']:&amp;#10;&amp;#10;                for repetition in range(2):&amp;#10;&amp;#10;                    # A dictionary stores the settings for one trial.&amp;#10;                    trial = {&amp;#10;                        'sound_condition': sound_condition,&amp;#10;                        'n_flashes': n_flashes,&amp;#10;                        'flash_position': flash_position&amp;#10;                    }&amp;#10;&amp;#10;                    block_trials.append(trial)&amp;#10;&amp;#10;    # Shuffle only after the balanced block is complete.&amp;#10;    trial_randomizer.shuffle(block_trials)&amp;#10;&amp;#10;    # Add this finished block to our list of blocks.&amp;#10;    all_blocks.append(block_trials)&amp;#10;    &amp;#10;# Blank list for filling in trial data later&amp;#10;session_list = list()&amp;#10;&amp;#10;#Randomize practice trial settings: number of flashes and flash position&amp;#10;practice_trial_flash_numbers = [1, 1, 2, 2, 2]&amp;#10;practice_trial_flash_positions = ['upper', 'lower', 'left', 'right', 'lower']&amp;#10;trial_randomizer.shuffle(practice_trial_flash_numbers)&amp;#10;trial_randomizer.shuffle(practice_trial_flash_positions)&amp;#10;&amp;#10;instruction_text = (&amp;#10;    &quot;Keep your eyes on the + at the center of the screen.\n\n&quot;&amp;#10;    &quot;A white flash will appear above or below the +.\n&quot;&amp;#10;    &quot;You may see ONE or TWO flashes.\n&quot;&amp;#10;    &quot;Decide whether a SECOND flash occurred, based only on what you saw.\n\n&quot;&amp;#10;    f&quot;{yes_key.upper()} = YES, I saw a second flash\n&quot;&amp;#10;    f&quot;{no_key.upper()} = NO, I saw only one flash\n\n&quot;&amp;#10;    &quot;Wait for the question before responding. &quot;&amp;#10;    &quot;Answer as fast as you can. The bar shows how much response time remains.\n\n&quot;&amp;#10;    &quot;Sit directly in front of the monitor, about one arm's length away. &quot;&amp;#10;    &quot;Keep your head position stable.\n\n&quot;&amp;#10;    &quot;There will be a practice section followed by three sections with breaks between them.\n\n&quot;&amp;#10;    &quot;Press SPACE to begin.&quot;&amp;#10;)" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="&amp;#10;        // add-on: list(s: string): string[]&amp;#10;        function list(s) {&amp;#10;            // if s is a string, we return a list of its characters&amp;#10;            if (typeof s === 'string')&amp;#10;                return s.split('');&amp;#10;            else&amp;#10;                // otherwise we return s:&amp;#10;                return s;&amp;#10;        }&amp;#10;&amp;#10;        import * as random from 'random';&amp;#10;import * as pd from 'pandas';&amp;#10;function _pj_snippets(container) {&amp;#10;    function in_es6(left, right) {&amp;#10;        if (((right instanceof Array) || ((typeof right) === &quot;string&quot;))) {&amp;#10;            return (right.indexOf(left) &gt; (- 1));&amp;#10;        } else {&amp;#10;            if (((right instanceof Map) || (right instanceof Set) || (right instanceof WeakMap) || (right instanceof WeakSet))) {&amp;#10;                return right.has(left);&amp;#10;            } else {&amp;#10;                return (left in right);&amp;#10;            }&amp;#10;        }&amp;#10;    }&amp;#10;    container[&quot;in_es6&quot;] = in_es6;&amp;#10;    return container;&amp;#10;}&amp;#10;_pj = {};&amp;#10;_pj_snippets(_pj);&amp;#10;participant = expInfo[&quot;participant&quot;].strip().toLowerCase();&amp;#10;trial_randomizer = new Math.random.Random(participant);&amp;#10;f_yes_names = [&quot;leilani&quot;, &quot;sophia&quot;, &quot;rebecca&quot;, &quot;riley&quot;, &quot;david&quot;, &quot;anna&quot;, &quot;vy&quot;, &quot;allah&quot;, &quot;patrick&quot;];&amp;#10;j_yes_names = [&quot;vidita&quot;, &quot;vicky&quot;, &quot;ava&quot;, &quot;ezekiel&quot;, &quot;wesley&quot;, &quot;jackson&quot;, &quot;hannah&quot;, &quot;erica&quot;];&amp;#10;all_names = (f_yes_names + j_yes_names);&amp;#10;participant_number = (util.index(all_names, participant) + 1);&amp;#10;if (_pj.in_es6(participant, f_yes_names)) {&amp;#10;    yes_key = &quot;f&quot;;&amp;#10;    no_key = &quot;j&quot;;&amp;#10;} else {&amp;#10;    if (_pj.in_es6(participant, j_yes_names)) {&amp;#10;        yes_key = &quot;j&quot;;&amp;#10;        no_key = &quot;f&quot;;&amp;#10;    } else {&amp;#10;        throw new ValueError(&quot;Participant name not found. Check the spelling.&quot;);&amp;#10;    }&amp;#10;}&amp;#10;sound_conditions = [&quot;no_beep&quot;, &quot;one_beep&quot;, &quot;two_sync&quot;, &quot;two_late&quot;];&amp;#10;all_blocks = [];&amp;#10;for (var block_number, _pj_c = 0, _pj_a = util.range(3), _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    block_number = _pj_a[_pj_c];&amp;#10;    block_trials = [];&amp;#10;    for (var sound_condition, _pj_f = 0, _pj_d = sound_conditions, _pj_e = _pj_d.length; (_pj_f &lt; _pj_e); _pj_f += 1) {&amp;#10;        sound_condition = _pj_d[_pj_f];&amp;#10;        for (var n_flashes, _pj_i = 0, _pj_g = [1, 2], _pj_h = _pj_g.length; (_pj_i &lt; _pj_h); _pj_i += 1) {&amp;#10;            n_flashes = _pj_g[_pj_i];&amp;#10;            for (var flash_position, _pj_l = 0, _pj_j = [&quot;upper&quot;, &quot;lower&quot;, &quot;right&quot;, &quot;left&quot;], _pj_k = _pj_j.length; (_pj_l &lt; _pj_k); _pj_l += 1) {&amp;#10;                flash_position = _pj_j[_pj_l];&amp;#10;                for (var repetition, _pj_o = 0, _pj_m = util.range(2), _pj_n = _pj_m.length; (_pj_o &lt; _pj_n); _pj_o += 1) {&amp;#10;                    repetition = _pj_m[_pj_o];&amp;#10;                    trial = {&quot;sound_condition&quot;: sound_condition, &quot;n_flashes&quot;: n_flashes, &quot;flash_position&quot;: flash_position};&amp;#10;                    block_trials.push(trial);&amp;#10;                }&amp;#10;            }&amp;#10;        }&amp;#10;    }&amp;#10;    trial_randomizer.shuffle(block_trials);&amp;#10;    all_blocks.push(block_trials);&amp;#10;}&amp;#10;session_list = list();&amp;#10;practice_trial_flash_numbers = [1, 1, 2, 2, 2];&amp;#10;practice_trial_flash_positions = [&quot;upper&quot;, &quot;lower&quot;, &quot;left&quot;, &quot;right&quot;, &quot;lower&quot;];&amp;#10;trial_randomizer.shuffle(practice_trial_flash_numbers);&amp;#10;trial_randomizer.shuffle(practice_trial_flash_positions);&amp;#10;instruction_text = `Keep your eyes on the + at the center of the screen.&amp;#10;&amp;#10;A white flash will appear above or below the +.&amp;#10;You may see ONE or TWO flashes.&amp;#10;Decide whether a SECOND flash occurred, based only on what you saw.&amp;#10;&amp;#10;${yes_key.upper()} = YES, I saw a second flash&amp;#10;${no_key.upper()} = NO, I saw only one flash&amp;#10;&amp;#10;Wait for the question before responding. Answer as fast as you can. The bar shows how much response time remains.&amp;#10;&amp;#10;Sit directly in front of the monitor, about one arm's length away. Keep your head position stable.&amp;#10;&amp;#10;There will be a practice section followed by three sections with breaks between them.&amp;#10;&amp;#10;Press SPACE to begin.`&amp;#10;;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_2" valType="code" updates="None" name="name"/>
      </CodeComponent>
